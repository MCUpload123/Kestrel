  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.kestrel.KestrelClient"
    ]
  },
  "mixins": [
    "kestrel.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "fabric-api": "*",
    "java": ">=25"
  }
}
